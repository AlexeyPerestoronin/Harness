{
    // Edit only this section.
    // Named values here are substituted into the rest of this file.
    "vars": {
        // Path to an agent file or to a folder with agent files (you will be asked to choose).
        // Relative paths are resolved against CWD and must stay inside CWD.
        "agent-config": "harness/agents/grok-4.6.json5",
        // Confirmation mode: "safe" (ask when a limit is exceeded) or "auto-accept" (log and continue).
        "mode": "safe",
        // Session token limit. Number, not a string. -1 = unlimited.
        "token-limit": 128000,
        // Session iteration limit. Number, not a string. -1 = unlimited. Fires on iteration limit+1.
        "iteration-limit": 50,
        // Session USD limit. Number, not a string. -1 = unlimited.
        "usd-limit": 0.5,
        // Log folder name, relative to CWD. Session logs go to
        // <cwd>/<log-folder>/<YYYY-MM-DD HH-MM>_<vendor>_<model>/.
        "log-folder": ".log",
        // Working directory for fs tools and run_shell, relative to CWD and inside CWD.
        "work-dir": ".",
        // Path or name of the git binary. Required. The code never falls back to "git".
        "git-executable": "git",
        // Timeout in seconds for git subprocesses. Number, not a string.
        "execution-limit": 120,
        // Timeout in seconds for run_shell. Number, not a string.
        "command-execution-limit": 120
    },
    // HTTPS server settings used by `harness.exe --serve`.
    "server": {
        // Bind address. Remote access only with explicit `--host`.
        "host": "127.0.0.1",
        // HTTPS port used when `--port` is not passed.
        "port": 4067,
        // Idle minutes before the server exits. Polling does not reset it.
        "live-timeout": 5,
        // Minutes to wait for a user response to a pending input.
        "interaction-timeout": 10,
        // Allowed CORS origins. Empty list = CORS disabled. `"*"` is not supported.
        "cors-allowed-origins": [],
        // Optional PEM certificate path. Relative paths are resolved from CWD; absolute paths are used as-is.
        // The path is not required to stay inside CWD. `null` = auto-generate a self-signed one.
        "tls-cert": null,
        // Optional PEM private-key path. Must be set together with `tls-cert`.
        "tls-key": null
    },
    // Model file, confirmation mode, session limits and log folder.
    "agent": {
        // Path to an agent file or to a folder with agent files (you will be asked to choose).
        // Relative paths are resolved against CWD and must stay inside CWD.
        "config": "${vars:agent-config}",
        // "safe" — confirm when a limit is exceeded; "auto-accept" — log and continue.
        "mode": "${vars:mode}",
        // Session token limit. `-1` = unlimited. Required (not taken from the model file).
        "token-limit": ${vars:token-limit},
        // Session iteration limit. `-1` = unlimited. Fires on iteration limit+1.
        "iteration-limit": ${vars:iteration-limit},
        // Session USD limit. `-1` = unlimited.
        "USD-limit": ${vars:usd-limit},
        // Log folder relative to CWD and inside CWD. Session logs go to
        // `<cwd>/<log-folder>/<YYYY-MM-DD HH-MM>_<vendor>_<model>/`.
        "log-folder": "${vars:log-folder}"
    },
    // Enabled tool modules. Key = module name (`crates/tools/src/<name>.rs`).
    // Missing key → module is not registered. Unknown key → startup error.
    "tools": {
        // Filesystem tools: read/write/create/remove/move file and folder, list_folder;
        // find_str, find_str_by_regex, find_file_by_str, find_files_by_regex;
        // list_available_file_extension, list_available_r_dir, list_available_w_dir,
        // list_available_r_file, list_available_w_file.
        "fs": {
            // Directory allow-list. Prefix `r:` (read) or `w:` (write; implies read). Match by abspath prefix.
            // Relative paths are resolved against CWD and must stay inside CWD.
            "available-dirs": [
                "w:${vars:work-dir}"
            ],
            // Allowed extensions including the dot (".md"). Empty list = any extension.
            "available-file-extensions": [
            ],
            // Exact-file allow-list outside `available-dirs`. Prefixes `r:` / `w:`.
            // Relative paths are resolved against CWD and must stay inside CWD.
            "available-files": [
            ],
            // Directories skipped by fs tools (build dirs, logs). Empty list is allowed.
            // No `r:` / `w:` prefixes (those mark access mode and are meaningless for a denylist).
            // Relative paths are resolved against CWD and must stay inside CWD.
            // An entry that coincides with or contains an `available-*` path is a load error.
            "deprecated-dirs": [
                ".git",
                "target"
            ],
            // Files skipped by fs tools. Empty list is allowed.
            // No `r:` / `w:` prefixes. Relative paths are resolved against CWD and must stay inside CWD.
            // Intersection with `available-files` is a load error.
            "deprecated-files": [
            ],
            // glob pattern `**/<component>` that deprecates a directory or file with this name at any depth.
            // Supported syntax: `**/<component>`; the only wildcard is `*`; regex is not supported.
            // Examples: `**/log`, `**/done`, `**/note-*`.
            "deprecated-dir-patterns": [
            ]
        },
        // Git tools: is_file_under_git, get_file_diff, apply_diff_patch, discard_file_changes.
        "git": {
            // Path or name of the git binary. Required. The code never falls back to "git".
            // The value is passed to `Command::new` as-is and is not resolved from CWD.
            "executable": "${vars:git-executable}",
            // Timeout in seconds for git subprocesses.
            "execution-limit": ${vars:execution-limit}
        },
        // Shell tools: run_shell.
        "terminal": {
            // Allowed cwd values for run_shell (abspath prefix match), separate from `available-dirs`.
            // Relative entries are resolved against CWD and must stay inside CWD.
            "cwd-list": [
                "${vars:work-dir}"
            ],
            // Command names without r:/w: prefixes.
            "available-commands": [
                "findstr",
                "cargo",
                "git",
            ],
            // Timeout in seconds for run_shell. Required if `terminal` is enabled.
            "command-execution-limit": ${vars:command-execution-limit}
        },
        // User interaction: ask_user, request_*_access_for, request_command_shell_execution.
        "user": {},
        // Skills catalog. Empty object = module on, no skills.
        // Add an entry as: "<name>": { "description": "<short text>", "file": "<path>" }.
        // `file` is resolved against CWD and must stay inside CWD, or absolute.
        // Missing files fail conf load (`error → skill-file '...' doesn't find`).
        "skills": {},
        // Roles catalog. Same shape as skills (`description` + `file`).
        // Tool: get_role_explanation. Files are checked at startup.
        "roles": {}
    }
}
