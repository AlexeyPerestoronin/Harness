{
    // Agent-loop config for task execution.
    
    "agent": {
        "config": "harness/agents",
        "mode": "auto-accept",
        "token-limit": 256000,
        "iteration-limit": 40,
        "USD-limit": 2.0,
        "log-folder": ".log"
    },
    "tools": {
        "fs": {
            "available-dirs": [
                "w:crates/tools/src",
                "r:crates/conf",
                "r:WiKi/todo/phase-7/pm-consulting report 3"
            ],
            "available-file-extensions": [],
            "available-files": [
                "r:crates/tools/Cargo.toml"
            ],
            "deprecated-dirs": [
                ".git",
                ".log",
                "target",
                "crates/web-harness/target",
                "WiKi/done"
            ],
            "deprecated-dir-patterns": [
                "**/done"
            ],
            "deprecated-files": []
        },
        "git": {
            "executable": "git",
            "execution-limit": 120
        },
        "terminal": {
            "cwd-list": [
                "."
            ],
            "available-commands": [
                "git diff",
                "git status",
                "git add",
                "git commit",
                "cargo"
            ],
            "command-execution-limit": 300
        },
        "user": {},
        "roles": {
            "senior-developer": {
                "description": "Применяется при разработке кода",
                "file": "harness/roles/senior-developer.md"
            }
        },
        "skills": {
            "rust-programming": {
                "description": "Написание кода на Rust",
                "file": "harness/skills/rust-programming.md"
            },
            "bugfixing": {
                "description": "Исправление багов и отладка",
                "file": "harness/skills/bugfixing.md"
            }
        }
    }
}
