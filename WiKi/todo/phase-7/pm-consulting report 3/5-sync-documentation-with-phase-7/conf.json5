{
    // Agent-loop config for task execution.
    
    "agent": {
        "config": "harness/agents",
        "mode": "auto-accept",
        "token-limit": 256000,
        "iteration-limit": 40,
        "USD-limit": 2.0,
        "log-folder": ".log"
    },
    "tools": {
        "fs": {
            "available-dirs": [
                "w:WiKi/todo/phase-7/pm-consulting report 3",
                "r:crates/cli-harness",
                "r:crates/tools",
                "r:crates/conf",
                "r:api",
                "r:.github/workflows"
            ],
            "available-file-extensions": [],
            "available-files": [
                "w:README.md",
                "w:crates/tools/help-user.txt",
                "w:api/v1/REST-API.help.md",
                "w:api/v1/openapi.yaml",
                "r:Cargo.toml",
                "r:crates/cli-harness/help.txt",
                "r:crates/conf/settings-template.json5"
            ],
            "deprecated-dirs": [
                ".git",
                ".log",
                "target",
                "crates/web-harness/target",
                "WiKi/done"
            ],
            "deprecated-files": []
        },
        "git": {
            "executable": "git",
            "execution-limit": 120
        },
        "terminal": {
            "cwd-list": [
                "."
            ],
            "available-commands": [
                "git"
            ],
            "command-execution-limit": 300
        },
        "user": {},
        "roles": {
            "senior-developer": {
                "description": "Применяется при разработке кода",
                "file": "harness/roles/senior-developer.md"
            }
        },
        "skills": {
            "rust-programming": {
                "description": "Написание кода на Rust",
                "file": "harness/skills/rust-programming.md"
            },
            "bugfixing": {
                "description": "Исправление багов и отладка",
                "file": "harness/skills/bugfixing.md"
            }
        }
    }
}
