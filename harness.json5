{
    // Model file, confirmation mode and session limits.
    "agent": {
        // Path to an agent file or to a folder with agent files (you will be asked to choose).
        "config": "harness/agents",
        // "safe" — confirm when a limit is exceeded; "auto-accept" — log and continue.
        "mode": "auto-accept",
        // Session token limit. `-1` = unlimited.
        "token-limit": 256000,
        // Session iteration limit. `-1` = unlimited. Fires on iteration limit+1.
        "iteration-limit": 40,
        // Session USD limit. `-1` = unlimited.
        "USD-limit": 2.0,
        // Session logs go to `<cwd>/log-folder/<YYYY-MM-DD HH-MM>_<vendor>_<model>/`.
        "log-folder": ".log"
    },
    "tools": {
        "fs": {
            "available-dirs": [
                "w:WiKi/todo/phase-7/pm-consulting report 3",
                "r:crates",
                "r:api",
            ],
            "available-file-extensions": [],
            "available-files": [
                "Cargo.toml",
                "Trunk.toml",
                "README.md",
            ],
            "deprecated-dirs": [
                ".git",
                ".log",
                "target",
                "crates/web-harness/target",
                "WiKi/done"
            ],
            "deprecated-dir-patterns": [
                "**/done"
            ],
            "deprecated-files": []
        },
        "git": {
            "executable": "git",
            "execution-limit": 120
        },
        "terminal": {
            "cwd-list": [
                "."
            ],
            "available-commands": [
                "git diff",
                "git status",
                "git add",
                "git commit",
                "cargo",
                "trunk"
            ],
            "command-execution-limit": 300,
            "invoke-execution-limit": 300
        },
        "user": {},
        "roles": {
            "project-manager": {
                "description": "Применяется при работе над проектом в ситуации когда требуется консультация относительно требований/запроса/вопросов от Project Owner",
                "file": "harness/roles/project-manager.md"
            },
            "design-reviewer": {
                "description": "Применяется при работе над проектом в ситуации когда требуется проверка результатов работы Project Manager",
                "file": "harness/roles/design-reviewer.md"
            },
            "tasks-manager": {
                "description": "Применяется при создании задач на разработку",
                "file": "harness/roles/tasks-manager.md"
            },
            "senior-developer": {
                "description": "Применяется при разработке кода",
                "file": "harness/roles/senior-developer.md"
            },
            "refactoring-manager": {
                "description": "Применяется при планировании анализе проекта с целью возможного рефакторинга",
                "file": "harness/roles/refactoring-manager.md"
            },
        },
        "skills": {
            "rust-programming": {
                "description": "Написание кода на Rust",
                "file": "harness/skills/rust-programming.md"
            },
            "bugfixing": {
                "description": "Исправление багов и отладка",
                "file": "harness/skills/bugfixing.md"
            }
        }
    }
}
